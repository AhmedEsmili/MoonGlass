<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient android:angle="270" android:startColor="#66FFFFFF" android:endColor="#24FFFFFF" />
            <stroke android:width="1dp" android:color="#C8FFFFFF" />
        </shape>
    </item>
    <item android:left="10dp" android:top="2dp" android:right="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient android:angle="270" android:startColor="#55FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
