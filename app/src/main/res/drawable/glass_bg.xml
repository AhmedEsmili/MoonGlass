<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- translucent body -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="40dp" />
            <gradient android:angle="315" android:startColor="#40FFFFFF" android:endColor="#14FFFFFF" />
        </shape>
    </item>
    <!-- outer specular rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="40dp" />
            <stroke android:width="1.5dp" android:color="#A6FFFFFF" />
        </shape>
    </item>
    <!-- inner dark rim (depth) -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="38dp" />
            <stroke android:width="1dp" android:color="#26000000" />
        </shape>
    </item>
    <!-- top sheen -->
    <item android:left="14dp" android:top="3dp" android:right="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient android:angle="270" android:startColor="#5CFFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- bottom caustic glow -->
    <item android:left="22dp" android:right="22dp" android:bottom="3dp"
        android:gravity="bottom" android:height="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="90" android:startColor="#38FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
